# Supabase — get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth — set up in Google Cloud Console, then add the redirect URI in Supabase Auth settings
# No env var needed here — configured via Supabase dashboard

# Local development only. Replaces Supabase with the seeded fixtures in
# lib/dev/fixtures.ts so the signed-in screens can be opened without
# completing Google OAuth. Ignored entirely in a production build — see the
# note at the top of that file. Leave this unset unless you want fake data.
# TALLY_DEV_FIXTURES=1
